<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/tab_generate"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="InfiniteGallery"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:letterSpacing="0.05"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI 图片生成 · 支持参考图"
                    android:textSize="13sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="20dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI 裂变批处理"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="给一个主题，AI 自动裂变创意并持续出图，直到你叫停"
                        android:textSize="12sp"
                        android:textColor="@color/text_tertiary"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/etBatchTheme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="主题方向，如：赛博朋克都市 / 水墨山水"
                        android:textColorHint="@color/text_tertiary"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_card"
                        android:padding="12dp"
                        android:minLines="1"
                        android:maxLines="2"
                        android:gravity="top" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="速率"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:id="@+id/llRate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp">

                        <Button
                            android:id="@+id/btnBatchStart"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="开始批量"
                            android:textColor="@color/chip_selected_text"
                            android:backgroundTint="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:stateListAnimator="@null"/>

                        <Button
                            android:id="@+id/btnBatchStop"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="停止"
                            android:textColor="@color/text_primary"
                            android:background="@drawable/bg_btn_outline"
                            android:textSize="14sp"
                            android:stateListAnimator="@null"
                            android:enabled="false"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvBatchStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="空闲"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginTop="10dp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="比例"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="10dp"/>

                    <LinearLayout
                        android:id="@+id/llRatio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="风格（可选）"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="10dp"/>

                    <LinearLayout
                        android:id="@+id/llStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"/>

                </LinearLayout>

                <EditText
                    android:id="@+id/etPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="描述你想要什么图，如：夕阳下的海边小城"
                    android:textColorHint="@color/text_tertiary"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:minLines="3"
                    android:maxLines="6"
                    android:gravity="top"
                    android:layout_marginTop="12dp" />

                <Button
                    android:id="@+id/btnGenerate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="生成图片"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/chip_selected_text"
                    android:backgroundTint="@color/text_primary"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/btnPolish"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:text="一键优化提示词（AI 润色）"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_btn_outline"
                    android:textSize="14sp"
                    android:stateListAnimator="@null"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnVariation"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:text="换一张重画"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_btn_outline"
                        android:textSize="14sp"
                        android:stateListAnimator="@null"/>

                    <Button
                        android:id="@+id/btnRandom"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="随机灵感"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_btn_outline"
                        android:textSize="14sp"
                        android:stateListAnimator="@null"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical">

                    <ProgressBar
                        android:id="@+id/pbLoading"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminateTint="@color/text_secondary"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="就绪"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:gravity="center_vertical"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/ivResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:minHeight="200dp"/>

                </FrameLayout>

                <TextView
                    android:id="@+id/tvPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/text_tertiary"
                    android:visibility="gone"
                    android:layout_marginTop="8dp"/>

                <Button
                    android:id="@+id/btnUpscale"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:text="放大到 4K（AI 超分）"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_btn_outline"
                    android:textSize="14sp"
                    android:stateListAnimator="@null"
                    android:enabled="false"/>

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="保存到相册"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_btn_outline"
                    android:textSize="14sp"
                    android:stateListAnimator="@null"
                    android:enabled="false"/>

            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/tab_img2img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="图生图"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:letterSpacing="0.05"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选参考图 → 自动反推提示词 → 按参考图重绘"
                    android:textSize="13sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="20dp"/>

                <Button
                    android:id="@+id/btnRef"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="选参考图（从相册）"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_btn_outline"
                    android:textSize="15sp"
                    android:stateListAnimator="@null"/>

                <FrameLayout
                    android:id="@+id/frameImgRefThumb"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_thumb"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivImgRefThumb"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="参考图预览"/>

                    <TextView
                        android:id="@+id/tvImgRefClear"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_ref_clear"
                        android:gravity="center"
                        android:text="×"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"/>

                </FrameLayout>

                <EditText
                    android:id="@+id/etImgPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="描述想要怎么改：如 变成水彩风格 / 换背景为雪山"
                    android:textColorHint="@color/text_tertiary"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:minLines="3"
                    android:maxLines="6"
                    android:gravity="top"
                    android:layout_marginTop="14dp" />

                <Button
                    android:id="@+id/btnImgGenerate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="按参考图生成"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/chip_selected_text"
                    android:backgroundTint="@color/text_primary"
                    android:stateListAnimator="@null"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical">

                    <ProgressBar
                        android:id="@+id/pbImgLoading"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminateTint="@color/text_secondary"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/tvImgStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="就绪"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:gravity="center_vertical"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/ivImgResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:minHeight="200dp"/>

                </FrameLayout>

                <Button
                    android:id="@+id/btnImgUpscale"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:text="放大到 4K（AI 超分）"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_btn_outline"
                    android:textSize="14sp"
                    android:stateListAnimator="@null"
                    android:enabled="false"/>

                <Button
                    android:id="@+id/btnImgSave"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="保存到相册"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_btn_outline"
                    android:textSize="14sp"
                    android:stateListAnimator="@null"
                    android:enabled="false"/>

            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/tab_gallery"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/llGallery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"/>
        </ScrollView>

        <ScrollView
            android:id="@+id/tab_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="设置"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="20dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="生成引擎（自动轮换）"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:id="@+id/tvEngine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Agnes 高速 → FLUX 免费 → 兜底"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="数据"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginBottom="10dp"/>

                    <Button
                        android:id="@+id/btnClearHistory"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:text="清空我的作品"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_btn_outline"
                        android:textSize="14sp"
                        android:stateListAnimator="@null"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="关于"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="InfiniteGallery v3.1\n三引擎自动轮换 · 参考图重绘\n提示词 AI 优化 · 反 AI 味"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"/>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav"/>

</LinearLayout>