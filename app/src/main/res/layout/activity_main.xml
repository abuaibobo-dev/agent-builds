<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="InfiniteGallery"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:letterSpacing="0.05"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI 图片生成 · 支持参考图"
            android:textSize="13sp"
            android:textColor="@color/text_tertiary"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="比例"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/llRatio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="风格（可选）"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/llStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>

        </LinearLayout>

        <EditText
            android:id="@+id/etPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="描述你想要什么图，如：夕阳下的海边小城"
            android:textColorHint="@color/text_tertiary"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:minLines="3"
            android:maxLines="6"
            android:gravity="top"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="生成图片"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/chip_selected_text"
            android:backgroundTint="@color/text_primary"
            android:stateListAnimator="@null"/>

        <Button
            android:id="@+id/btnPolish"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:text="一键优化提示词（AI 润色）"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_btn_outline"
            android:textSize="14sp"
            android:stateListAnimator="@null"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRef"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="参考图"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_outline"
                android:textSize="14sp"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/btnVariation"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="换一张重画"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_outline"
                android:textSize="14sp"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/btnRandom"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="随机灵感"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_outline"
                android:textSize="14sp"
                android:stateListAnimator="@null"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <ProgressBar
                android:id="@+id/pbLoading"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/text_secondary"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="就绪"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:gravity="center_vertical"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:padding="8dp">

            <ImageView
                android:id="@+id/ivResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:minHeight="200dp" />

            <FrameLayout
                android:id="@+id/frameRefThumb"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:visibility="gone"
                android:background="@drawable/bg_thumb">

                <ImageView
                    android:id="@+id/ivRefThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="参考图缩略图"/>

                <TextView
                    android:id="@+id/tvRefClear"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_ref_clear"
                    android:gravity="center"
                    android:text="×"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"/>

            </FrameLayout>

        </FrameLayout>

        <TextView
            android:id="@+id/tvPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_tertiary"
            android:visibility="gone"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="保存到相册"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_outline"
                android:textSize="14sp"
                android:stateListAnimator="@null"
                android:enabled="false"/>

            <Button
                android:id="@+id/btnHistory"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="我的作品"
                android:textColor="@color/chip_selected_text"
                android:backgroundTint="@color/text_primary"
                android:textSize="14sp"
                android:stateListAnimator="@null"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>